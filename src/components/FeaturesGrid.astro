---
// src/components/FeaturesGrid.astro
---

<section class="w-full border-b border-hairline py-16 sm:py-24 transition-colors">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-12 max-w-2xl">
      <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-mute">
        Engineered for Focus
      </span>
      <h2 class="mt-2 font-sans text-2xl sm:text-3xl font-semibold tracking-[-1.28px] text-ink">
        Everything you need to study, learn, and watch with intent.
      </h2>
      <p class="mt-3 text-[14px] leading-relaxed text-body">
        The average person spends 40+ minutes per YouTube visit chasing algorithmic suggestions they never intended to watch. TubeCalm strips away the traps.
      </p>
    </div>

    <!-- 4-Card Hairline Grid -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Feature 1: No Algorithm -->
      <div class="flex flex-col justify-between rounded-xl border border-hairline bg-canvas-elevated p-6 shadow-[0_1px_1px_rgba(0,0,0,0.03)] transition-all hover:border-body/30">
        <div>
          <div class="flex h-9 w-9 items-center justify-center rounded-[6px] border border-hairline bg-canvas text-ink mb-4">
            <!-- Cut feed icon -->
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
          </div>
          <h3 class="font-sans text-[16px] font-semibold tracking-[-0.3px] text-ink">Zero Algorithmic Traps</h3>
          <p class="mt-2 text-[13px] leading-relaxed text-body">
            No homepage feed, no sidebar recommendations, no related video rabbit-holes, and no end-screen popups competing for your attention.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-hairline/60">
          <span class="font-mono text-[10px] uppercase tracking-wider text-mute">Clutter Eliminated: 100%</span>
        </div>
      </div>

      <!-- Feature 2: Universal URL Engine -->
      <div class="flex flex-col justify-between rounded-xl border border-hairline bg-canvas-elevated p-6 shadow-[0_1px_1px_rgba(0,0,0,0.03)] transition-all hover:border-body/30">
        <div>
          <div class="flex h-9 w-9 items-center justify-center rounded-[6px] border border-hairline bg-canvas text-ink mb-4">
            <!-- Link Engine icon -->
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <h3 class="font-sans text-[16px] font-semibold tracking-[-0.3px] text-ink">Smart URL Parser</h3>
          <p class="mt-2 text-[13px] leading-relaxed text-body">
            Accepts standard videos, youtu.be links, full playlists, live streams, timestamps (e.g. <code>?t=90s</code>), and converts Shorts to standard video.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-hairline/60">
          <span class="font-mono text-[10px] uppercase tracking-wider text-mute">All Formats Supported</span>
        </div>
      </div>

      <!-- Feature 3: Deep Work Companion -->
      <div class="flex flex-col justify-between rounded-xl border border-hairline bg-canvas-elevated p-6 shadow-[0_1px_1px_rgba(0,0,0,0.03)] transition-all hover:border-body/30">
        <div>
          <div class="flex h-9 w-9 items-center justify-center rounded-[6px] border border-hairline bg-canvas text-ink mb-4">
            <!-- Timer / Notes icon -->
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-sans text-[16px] font-semibold tracking-[-0.3px] text-ink">Focus & Notes Built-in</h3>
          <p class="mt-2 text-[13px] leading-relaxed text-body">
            Built-in Pomodoro focus timer, interactive notes scratchpad with clickable timestamp jump points, loop playback, and ambient cinema dimmer.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-hairline/60">
          <span class="font-mono text-[10px] uppercase tracking-wider text-mute">Study & Research Mode</span>
        </div>
      </div>

      <!-- Feature 4: Privacy-First Architecture -->
      <div class="flex flex-col justify-between rounded-xl border border-hairline bg-canvas-elevated p-6 shadow-[0_1px_1px_rgba(0,0,0,0.03)] transition-all hover:border-body/30">
        <div>
          <div class="flex h-9 w-9 items-center justify-center rounded-[6px] border border-hairline bg-canvas text-ink mb-4">
            <!-- Shield icon -->
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-sans text-[16px] font-semibold tracking-[-0.3px] text-ink">100% Client-Side Privacy</h3>
          <p class="mt-2 text-[13px] leading-relaxed text-body">
            No mandatory accounts or signups. Your history and notes remain saved strictly in your local browser storage with one-click data purge.
          </p>
        </div>
        <div class="mt-6 pt-3 border-t border-hairline/60">
          <span class="font-mono text-[10px] uppercase tracking-wider text-mute">Zero Tracking Cookies</span>
        </div>
      </div>
    </div>
  </div>
</section>

