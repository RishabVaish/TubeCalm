---
// src/components/FaqAccordion.astro
const faqs = [
  {
    q: "How does TubeCalm work?",
    a: "TubeCalm is a lightweight web utility. When you paste any YouTube video or playlist link, it extracts the unique ID and loads the video using Google's official YouTube IFrame Player API inside a minimal, distraction-free interface. We completely omit the recommendation sidebar, comments section, Shorts feed, and homepage algorithms."
  },
  {
    q: "Does TubeCalm support YouTube Playlists and timestamps?",
    a: "Yes! You can paste full playlist URLs (e.g., https://www.youtube.com/playlist?list=...) or links to a video within a playlist. If your link contains a timestamp (such as ?t=1m30s or ?t=90), TubeCalm will automatically start the player at that exact second."
  },
  {
    q: "Can I watch YouTube Shorts horizontally without the endless vertical scroll?",
    a: "Yes. When you paste a YouTube Shorts URL (e.g., https://www.youtube.com/shorts/VIDEO_ID), TubeCalm parses the video ID and renders it inside the standard horizontal 16:9 player with full scrub and playback controls, preventing the endless swipe loop."
  },
  {
    q: "Do creators still get credit and view counts?",
    a: "Yes. TubeCalm utilizes the official YouTube IFrame Player API. Video views, watch time, and creator metrics count through YouTube's embedded player standards, exactly as Google intends for embedded web playback."
  },
  {
    q: "Is my personal data or watch history sent to any server?",
    a: "No. TubeCalm does not have a backend database or mandatory accounts. Your recent watch history and timestamped study notes are saved strictly in your local browser's localStorage. You can permanently wipe all stored data at any time with a single click."
  },
  {
    q: "Is TubeCalm safe for classrooms, universities, and presentations?",
    a: "Absolutely. TubeCalm was built specifically for students, educators, developers, and professionals who want to show a video without having inappropriate comment sections, unrelated algorithmic suggestions, or distracting thumbnails visible on screen."
  },
  {
    q: "Do I need to install a browser extension?",
    a: "No installation is required. TubeCalm works directly in any modern browser on Windows, Mac, Linux, iPhone, iPad, Android, and Chromebooks. You can bookmark tubecalm.com or add it to your home screen."
  }
];
---

<section class="w-full py-16 sm:py-24 transition-colors">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="mb-10 text-center">
      <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-mute">
        Answers
      </span>
      <h2 class="mt-2 font-sans text-2xl sm:text-3xl font-semibold tracking-[-1.28px] text-ink">
        Frequently Asked Questions
      </h2>
      <p class="mt-2 text-[14px] text-body">
        Everything you need to know about TubeCalm's distraction-free player.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((item, idx) => (
        <details class="group rounded-xl border border-hairline bg-canvas-elevated p-4 shadow-[0_1px_1px_rgba(0,0,0,0.03)] transition-colors hover:border-body/30 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer items-center justify-between font-sans text-[15px] font-medium text-ink focus:outline-none">
            <span>{item.q}</span>
            <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-[6px] border border-hairline bg-canvas text-mute transition-transform duration-200 group-open:rotate-180">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-[13px] leading-relaxed text-body pt-2 border-t border-hairline/60">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

