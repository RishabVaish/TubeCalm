---
// src/components/Header.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-40 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md transition-colors">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Brand / Wordmark -->
    <a href="/" class="group flex items-center gap-2.5 text-ink transition-opacity hover:opacity-85" aria-label="TubeCalm Home">
      <div class="flex h-7 w-7 items-center justify-center rounded-[6px] border border-hairline bg-canvas-elevated text-ink shadow-[0_1px_1px_rgba(0,0,0,0.04)]">
        <!-- Minimal Soundwave / Play icon -->
        <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h2v12H4zm5-3h2v18H9zm5 5h2v8h-2zm5-3h2v14h-2z" />
        </svg>
      </div>
      <div class="flex items-baseline gap-1.5">
        <span class="font-sans text-[15px] font-semibold tracking-[-0.4px] text-ink">TubeCalm</span>
        <span class="font-mono text-[10px] font-medium uppercase tracking-wider text-mute">distraction-free</span>
      </div>
    </a>

    <!-- Nav Links (Desktop) -->
    <nav class="hidden items-center gap-1 sm:flex" aria-label="Main Navigation">
      <a 
        href="/" 
        class:list={[
          "rounded-full px-3 py-1 text-[13px] font-normal transition-colors",
          currentPath === '/' ? "bg-hairline-soft font-medium text-ink" : "text-body hover:text-ink hover:bg-hairline-soft/60"
        ]}
      >
        Player
      </a>
      <a 
        href="/about" 
        class:list={[
          "rounded-full px-3 py-1 text-[13px] font-normal transition-colors",
          currentPath === '/about' ? "bg-hairline-soft font-medium text-ink" : "text-body hover:text-ink hover:bg-hairline-soft/60"
        ]}
      >
        About
      </a>
      <a 
        href="/faq" 
        class:list={[
          "rounded-full px-3 py-1 text-[13px] font-normal transition-colors",
          currentPath === '/faq' ? "bg-hairline-soft font-medium text-ink" : "text-body hover:text-ink hover:bg-hairline-soft/60"
        ]}
      >
        FAQ
      </a>
      <a 
        href="/privacy" 
        class:list={[
          "rounded-full px-3 py-1 text-[13px] font-normal transition-colors",
          currentPath === '/privacy' ? "bg-hairline-soft font-medium text-ink" : "text-body hover:text-ink hover:bg-hairline-soft/60"
        ]}
      >
        Privacy
      </a>
    </nav>

    <!-- Chrome Actions -->
    <div class="flex items-center gap-2">
      <!-- Keyboard shortcuts trigger button -->
      <button 
        id="shortcuts-btn" 
        type="button" 
        class="hidden h-8 items-center gap-1.5 rounded-[6px] border border-hairline bg-canvas-elevated px-2 text-[12px] font-mono text-mute transition-colors hover:border-body/40 hover:text-ink md:inline-flex"
        title="View Keyboard Shortcuts (or press ?)"
        aria-label="Keyboard Shortcuts"
      >
        <span>Shortcuts</span>
        <kbd class="rounded border border-hairline bg-canvas px-1 py-0.5 text-[10px]">?</kbd>
      </button>

      <!-- Theme Toggle (Dark / Light) -->
      <button 
        id="theme-toggle" 
        type="button" 
        class="flex h-8 w-8 items-center justify-center rounded-[6px] border border-hairline bg-canvas-elevated text-mute transition-colors hover:border-body/40 hover:text-ink"
        title="Toggle Dark / Light Theme"
        aria-label="Toggle Theme"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="sun-icon" class="hidden h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5" />
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="moon-icon" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
        </svg>
      </button>

      <!-- Mobile Nav Dropdown Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="flex h-8 w-8 items-center justify-center rounded-[6px] border border-hairline bg-canvas-elevated text-body hover:text-ink sm:hidden"
        aria-label="Toggle mobile menu"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden border-b border-hairline bg-canvas px-4 py-3 sm:hidden">
    <div class="flex flex-col gap-1">
      <a href="/" class="rounded-md px-3 py-2 text-[14px] text-body hover:bg-hairline-soft hover:text-ink">Player</a>
      <a href="/about" class="rounded-md px-3 py-2 text-[14px] text-body hover:bg-hairline-soft hover:text-ink">About</a>
      <a href="/faq" class="rounded-md px-3 py-2 text-[14px] text-body hover:bg-hairline-soft hover:text-ink">FAQ</a>
      <a href="/privacy" class="rounded-md px-3 py-2 text-[14px] text-body hover:bg-hairline-soft hover:text-ink">Privacy</a>
    </div>
  </div>
</header>

<script>
  // Theme Toggle Logic
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    }
  }

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('tubecalm_theme', isDark ? 'dark' : 'light');
      updateThemeUI();
    });
  }

  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Initialize theme icons
  updateThemeUI();
</script>

