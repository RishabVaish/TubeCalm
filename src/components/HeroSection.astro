---
// src/components/HeroSection.astro
---

<section class="geist-mesh relative w-full border-b border-hairline py-16 sm:py-24 transition-colors">
  <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
    <!-- Technical Eyebrow (Geist Mono) -->
    <div class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas-elevated/80 px-3 py-1 backdrop-blur-sm shadow-[0_1px_1px_rgba(0,0,0,0.03)]">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-mute">
        Zero Distraction YouTube Utility
      </span>
    </div>

    <!-- Main Display Headline (Geist Sans 600, -2.4px tracking) -->
    <h1 class="mt-6 font-sans text-4xl font-semibold tracking-[-2.4px] text-ink sm:text-6xl sm:leading-[1.08]">
      Watch what you intended.<br class="hidden sm:inline" />
      <span class="text-body font-normal">Nothing more.</span>
    </h1>

    <!-- Subtitle (body-lg) -->
    <p class="mx-auto mt-4 max-w-xl text-[16px] leading-relaxed text-body sm:text-[17px]">
      Paste any YouTube video or playlist link to watch in a stripped-down, focused interface. No recommendations, no Shorts doomscroll, no toxic comments, and no algorithm.
    </p>

    <!-- Key Metrics / Highlights -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-[13px] text-mute">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span>No extension required</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span>100% Client-side privacy</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        <span>Video & Playlist support</span>
      </div>
    </div>
  </div>
</section>

