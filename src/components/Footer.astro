---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-hairline bg-canvas transition-colors">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Col 1: Brand & Promise -->
      <div class="space-y-3 md:col-span-2">
        <div class="flex items-center gap-2">
          <div class="flex h-6 w-6 items-center justify-center rounded-[6px] border border-hairline bg-canvas-elevated text-ink">
            <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 6h2v12H4zm5-3h2v18H9zm5 5h2v8h-2zm5-3h2v14h-2z" />
            </svg>
          </div>
          <span class="font-sans text-[15px] font-semibold tracking-[-0.3px] text-ink">TubeCalm</span>
        </div>
        <p class="max-w-md text-[13px] leading-relaxed text-mute">
          A distraction-free YouTube utility designed to restore focus. No infinite feeds, no clickbait rabbit holes, no algorithmic recommendations, and no tracking cookies.
        </p>
        <div class="flex items-center gap-3 pt-1">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas-elevated px-2.5 py-0.5 text-[11px] font-mono text-mute">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            100% Client-Side Privacy
          </span>
          <span class="text-[11px] font-mono text-mute">No Signup Required</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-2.5">
        <h3 class="font-mono text-[11px] font-medium uppercase tracking-wider text-mute">Product</h3>
        <ul class="space-y-1.5 text-[13px]">
          <li><a href="/" class="text-body transition-colors hover:text-ink">Distraction-Free Player</a></li>
          <li><a href="/about" class="text-body transition-colors hover:text-ink">Our Mission</a></li>
          <li><a href="/faq" class="text-body transition-colors hover:text-ink">FAQ & Help</a></li>
          <li><a href="/privacy" class="text-body transition-colors hover:text-ink">Privacy Manifesto</a></li>
        </ul>
      </div>

      <!-- Col 3: Comparison & Specs -->
      <div class="space-y-2.5">
        <h3 class="font-mono text-[11px] font-medium uppercase tracking-wider text-mute">Why TubeCalm</h3>
        <ul class="space-y-1.5 text-[13px] text-body">
          <li class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Zero browser extension required
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Full playlist & Shorts support
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Built-in Focus & Notes tools
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            Official YouTube Player API
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-hairline pt-6 text-[12px] text-mute sm:flex-row">
      <div class="flex items-center gap-2">
        <span>© {year} TubeCalm (tubecalm.com).</span>
        <span>Independent web utility. YouTube is a trademark of Google LLC.</span>
      </div>
      <div class="flex items-center gap-4">
        <span>Press <kbd class="rounded border border-hairline bg-canvas-elevated px-1.5 py-0.5 font-mono text-[10px] text-ink">?</kbd> anytime for shortcuts</span>
        <a href="#top" class="text-body hover:text-ink">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>

